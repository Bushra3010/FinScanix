# FinScanix — environment template.
# Copy to .env.local and fill in. Never commit the filled file (NDA §12).
#
# Every key below is optional in the prototype: when a key is absent the app
# falls back to the mock adapter in src/lib/adapters/mock.ts. Setting a key
# switches that one service to its live provider — nothing else changes.
#
# None of these may be prefixed NEXT_PUBLIC_ — they are server-side only.

# Market pricing search — FR-4.1 (Serper, or swap the adapter for another provider)
SERPER_API_KEY=

# Payment gateway — FR-8.2
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI: document extraction, quality gate and the domain-restricted assistant — FR-2.1, FR-1.2, FR-10
ANTHROPIC_API_KEY=

# Database — not used by the prototype; added when the data layer replaces the fixtures
DATABASE_URL=
