# FinScanix — environment template.
# Copy to .env.local and fill in. Never commit the filled file (NDA §12).
#
# Every key below is optional in the prototype: when a key is absent the app
# falls back to the mock adapter in src/lib/adapters/mock.ts. Setting a key
# switches that one service to its live provider — nothing else changes.
#
# None of these may be prefixed NEXT_PUBLIC_ — they are server-side only.

# Market pricing search — FR-4.1 (Serper, or swap the adapter for another provider)
SERPER_API_KEY=

# Payment gateway — FR-8.2
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI: document extraction, quality gate and the domain-restricted assistant — FR-2.1, FR-1.2, FR-10
ANTHROPIC_API_KEY=

# Database — Supabase Postgres.
#
# DATABASE_URL: transaction pooler (port 6543) for application queries.
#   The pgbouncer flag stops Prisma using prepared statements the pooler
#   cannot support; connection_limit=1 suits serverless/container runtimes.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL: session connection (port 5432) used only by Prisma Migrate.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase API — used for document storage, not for database access.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# Password used for every seeded demo account. Development only.
SEED_PASSWORD=

# Scheduled jobs — FR-9.2.
#
# Next.js has no in-process scheduler, so the schedule lives outside the app:
# a platform cron calls GET /api/cron with this secret as a bearer token, and
# the endpoint runs whatever is due. Without it, /api/cron returns 503 and only
# the "Run now" button executes a job.
#
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron
#
# Generate with:  openssl rand -base64 32
CRON_SECRET=

# Absolute origin of this deployment, used in Razorpay callback URLs.
APP_BASE_URL=
